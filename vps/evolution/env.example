# Copie para .env na VPS. __API_KEY__, __PG_PASS__ e __RENDER_TOKEN__ recebem valores aleatórios (openssl rand -hex 24).
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://vps73947.publiccloud.com.br
LANGUAGE=pt-BR
TELEMETRY_ENABLED=false

AUTHENTICATION_API_KEY=__API_KEY__
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

POSTGRES_PASSWORD=__PG_PASS__
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:__PG_PASS__@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Orbit
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

# Gerador de cards (orbit-render)
RENDER_TOKEN=__RENDER_TOKEN__

# Webhook Evolution -> Supabase (whatsapp-webhook); o mesmo valor vai no secret WHATSAPP_WEBHOOK_TOKEN
WHATSAPP_WEBHOOK_TOKEN=__WEBHOOK_TOKEN__
